rules_version = '2';

// Görev Defteri — Cloud Firestore security rules.
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
// Data layout: users/{uid}/tasks/{taskId}; each document has exactly the Task fields
// ('failed' is optional: older documents don't have it).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidTask(d, taskId) {
      return d.keys().hasAll(['id', 'title', 'date', 'time', 'done', 'createdAt', 'categoryId', 'recurrenceId'])
        && d.keys().hasOnly(['id', 'title', 'date', 'time', 'done', 'createdAt', 'categoryId', 'recurrenceId', 'failed'])
        && d.id == taskId
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 200
        && d.date is string && d.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && (d.time == null || (d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && d.done is bool
        && (!('failed' in d) || d.failed is bool)
        && d.createdAt is number
        && (d.categoryId == null || d.categoryId is string)
        && (d.recurrenceId == null || d.recurrenceId is string);
    }

    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidTask(request.resource.data, taskId);
    }

    // Everything else (other users, other collections, deeper paths) is denied by default.
  }
}
